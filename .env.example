# ==============================================================================
# RG STUDIO MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# NEVER commit real .env files or service-role secrets to source control.
# Never embed database passwords, service-role keys, or JWT secrets in desktop EXE builds.

# --- AI Studio Runtime Variables (if applicable) ---
GEMINI_API_KEY=""
APP_URL=""

# --- Phase 1 Web Sandbox (Express Preview Server on port 3000, NOT FastAPI) ---
RG_SANDBOX_JWT_SECRET=""

# --- FastAPI Backend Server (Hosted Backend: Railway / Render / Fly.io / VPS) ---
RG_ENVIRONMENT="development"
RG_APP_NAME="RG Studio Management System API"
RG_API_V1_PREFIX="/api/v1"

# Supabase PostgreSQL connection strings (Server-side ONLY)
# Async runtime driver MUST use postgresql+asyncpg://
# Format: postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
RG_DATABASE_URL=""

# Sync Alembic migration driver MUST use postgresql+psycopg://
# Format: postgresql+psycopg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
RG_DATABASE_SYNC_URL=""

# Enforce TLS SSL (verify-full) for Supabase PostgreSQL and disable asyncpg prepared-statement cache for Supavisor port 6543
RG_DB_SSL_REQUIRE="true"
RG_DB_POOLER_MODE="true"
# Optional custom/override PostgreSQL Root CA path or PEM (Supabase Root 2021 CA is bundled at backend/certs/supabase-prod-ca-2021.crt)
RG_DB_SSL_CA_FILE=""
RG_DB_SSL_CA_CERT=""

# JWT Signing Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
RG_JWT_SECRET_KEY=""
RG_JWT_REFRESH_SECRET_KEY=""
RG_ACCESS_TOKEN_EXPIRE_MINUTES="30"
RG_REFRESH_TOKEN_EXPIRE_DAYS="7"

# One-time bootstrap token required on first-run Admin creation (remove/rotate after setup)
RG_SETUP_BOOTSTRAP_TOKEN=""

# Security & Rate Limiting
RG_LOCKOUT_THRESHOLD="5"
RG_LOCKOUT_MINUTES="15"
RG_CORS_ORIGINS=""

# --- Permanent Encrypted Configuration & Storage (Server-Side ONLY) ---
# External 256-bit (32+ char) master key used to encrypt saved server config at rest (keep in hosting Secrets).
RG_CONFIG_ENCRYPTION_KEY=""
# Optional previous master key kept temporarily during hosting secret cutover
RG_CONFIG_ENCRYPTION_KEY_PREVIOUS=""
# Optional durable disk mount path (e.g., /var/data on Render Persistent Disk or /data on Railway Volume)
RG_PERSISTENT_DATA_DIR=""

# --- Desktop Client (PySide6 Windows App) ---
# Intentionally blank until FastAPI backend is deployed over HTTPS.
# Desktop clients must NEVER store database credentials or JWT secrets.
RG_API_BASE_URL=""
